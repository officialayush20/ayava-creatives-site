# Copy this file to `.env.local` (gitignored — never commit real secrets)
# and fill in real values.

# Resend API key — used by app/api/contact/route.ts and app/api/careers/route.ts
# to send form-submission emails to info@ayavacreatives.com.
# Get one from the Resend dashboard: https://resend.com/api-keys
# Without this set, both routes respond with a clear 503
# "Email delivery is not yet configured." error instead of failing silently.
RESEND_API_KEY=

# HubSpot Private App access token — used by app/api/contact/route.ts to
# create/update a CRM contact for each Contact form submission (best-effort;
# the contact email always sends regardless of this being set).
# To get one: HubSpot account -> Settings -> Integrations -> Private Apps ->
# Create a private app -> under "Scopes" enable crm.objects.contacts.write ->
# Create app -> copy the generated access token here.
# Without this set, HubSpot sync is silently skipped (logged, not fatal).
HUBSPOT_API_KEY=

# --- Client Portal (app/(portal)/, lib/auth.ts) ---
#
# PLACEHOLDER single-admin auth. There are no real client accounts yet, so
# the portal has exactly one login (the founder), not a users table. This
# is intentional — a real multi-client auth system (per-client accounts,
# roles, password reset) is a follow-up task once real clients exist.

# NextAuth session-signing secret. Generate one with:
#   openssl rand -base64 32
# (Git Bash / WSL / macOS / Linux all have openssl. On Windows without it,
# use `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.)
NEXTAUTH_SECRET=

# The one portal login's email address (plain text — this is not a secret
# by itself, but keep it in .env.local anyway so it's not hardcoded).
PORTAL_ADMIN_EMAIL=

# Bcrypt HASH of the portal login's password — never store the plaintext
# password here or anywhere else. To generate a hash for a chosen password,
# run from the project root:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-chosen-password"
# Copy the printed hash (starts with $2a$ or $2b$) as the value below.
PORTAL_ADMIN_PASSWORD_HASH=

# --- AI Chat Concierge (app/api/chat/route.ts, lib/chatbot-knowledge.ts) ---
#
# Google Gemini API key — powers the on-site AI chat widget, grounded in
# lib/chatbot-knowledge.ts (real services/industries/process/case studies,
# no fabricated content). Get a free key (no credit card required) from
# Google AI Studio: https://aistudio.google.com/app/apikey — sign in with a
# Google account, click "Create API key", copy it here.
# Without this set, /api/chat responds with a clear 503
# "Chat is not yet configured." error and the widget shows a graceful
# message instead of failing silently.
GEMINI_API_KEY=
